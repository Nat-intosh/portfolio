# URL used by the Nuxt server to reach Strapi.
# In Docker this can be an internal service name, e.g. http://strapi:1337
NUXT_STRAPI_URL=http://localhost:1337

# URL used by the browser for API calls and uploaded media.
# It must be reachable from outside the Docker network.
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Docker Compose example (set these in the root `.env` instead):
# NUXT_STRAPI_URL=http://strapi:1337
# NUXT_PUBLIC_STRAPI_URL=https://api.nellvand.fr
