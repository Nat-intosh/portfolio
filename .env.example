# ---------------------------------------------------------------------------
# Docker Compose environment
#
# Copy this file to `.env` at the repository root, then replace every
# `change-me` value. The `.env` file is ignored by git and must never be
# committed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Nginx Proxy Manager network
# ---------------------------------------------------------------------------
#
# Nginx Proxy Manager is already running in Docker (container `npm-app-1`).
# This stack joins its Docker network so NPM can reach the containers directly:
#   https://nellvand.fr      -> http://nuxt:3000
#   https://api.nellvand.fr  -> http://strapi:1337
#
# Verify the network name with:
#   docker inspect npm-app-1 --format '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}}{{"\n"}}{{end}}'
#
# The default below matches a Compose project named `npm`, which creates the
# container name `npm-app-1` and the network `npm_default`.
NPM_NETWORK=npm_default

# Server timezone (useful for logs and Strapi dates).
TZ=Europe/Paris

# ---------------------------------------------------------------------------
# Nuxt
# ---------------------------------------------------------------------------

# Internal URL used by the Nuxt server for SSR requests.
NUXT_STRAPI_URL=http://strapi:1337

# Public URL used by the browser for API calls and uploaded media. It must be
# reachable from the internet.
NUXT_PUBLIC_STRAPI_URL=https://api.nellvand.fr

# ---------------------------------------------------------------------------
# Strapi
# ---------------------------------------------------------------------------

# Public URL of the Strapi API/admin, without a trailing slash.
PUBLIC_URL=https://api.nellvand.fr

# Browser origins allowed to call the Strapi API. Comma-separated.
# Add https://www.nellvand.fr here if you also configure the www hostname.
CORS_ORIGINS=https://nellvand.fr

# Generate new secrets for production. Never reuse the local development
# secrets from `strapi/.env`.
#
# APP_KEYS must contain four comma-separated random values. Example generation
# command (run it four times and join the results with commas):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite keeps the existing portfolio content and needs no extra service. The
# database file is persisted in `./data/strapi/db/data.db`.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# PostgreSQL values, only used after switching DATABASE_CLIENT to `postgres`.
# See the PostgreSQL section in README.md before changing these.
# DATABASE_HOST=db
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=change-me
# DATABASE_SSL=false
