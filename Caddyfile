# Public portfolio (Nuxt)
#
# If you also want www.nellvand.fr, create its DNS record first, then replace
# the site address below with:
#   {$DOMAIN}, www.{$DOMAIN} {
# and add this redirect just after the opening brace:
#   @www host www.{$DOMAIN}
#   redir @www https://{$DOMAIN}{uri} permanent
{$DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
    }

    reverse_proxy nuxt:3000
}

# Strapi API, media and admin panel
{$API_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Robots-Tag "noindex, nofollow"
    }

    reverse_proxy strapi:1337
}
