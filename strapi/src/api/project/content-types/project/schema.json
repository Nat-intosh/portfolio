{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "cover_credit": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "project_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project-category.project-category",
      "inversedBy": "projects"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "mappedBy": "projects"
    },
    "description": {
      "type": "text"
    },
    "date": {
      "type": "date"
    },
    "content_zone": {
      "type": "dynamiczone",
      "components": [
        "project.single-media",
        "project.multiple-medias",
        "project.text",
        "project.attached-files",
        "project.embed"
      ]
    }
  }
}
